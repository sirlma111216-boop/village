{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trust-village",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  // qrcode 패키지가 Buffer 등 Node 내장 몇 가지를 쓴다
  "compatibility_flags": ["nodejs_compat"],

  // 화면·CSS·폰트는 Workers Assets 가 그대로 내보낸다 (별도 서버가 필요 없다)
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // .html 을 자동으로 붙이거나 떼지 않는다 — 우리가 직접 라우팅한다
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/ws", "/api/*", "/host"]
  },

  // 수업 하나 = Durable Object 하나.
  // 그 안에 상태와 WebSocket 이 함께 있어서 실시간 처리가 한곳에서 끝난다.
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "VillageSession" }
    ]
  },

  // SQLite 저장소를 쓰면 무료 요금제에서도 Durable Objects 를 쓸 수 있다
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VillageSession"] }
  ],

  "observability": { "enabled": true }
}
